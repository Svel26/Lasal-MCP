{
  "name": "lasal-mcp",
  "version": "0.3.2",
  "description": "MCP server for LASAL IDE automation",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "lasal-mcp": "dist/server.js",
    "lasal-class2-mcp": "dist/servers/class2.js",
    "lasal-visu-mcp": "dist/servers/visu.js",
    "lasal-screen-mcp": "dist/servers/screen.js",
    "lasal-lars-mcp": "dist/servers/lars.js",
    "lasal-solution-mcp": "dist/servers/solution.js",
    "lasal-mcp-init": "dist/cli/init.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Svel26 <sjjansen06@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Svel26/Lasal-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Svel26/Lasal-MCP/issues"
  },
  "homepage": "https://github.com/Svel26/Lasal-MCP#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lasal",
    "sigmatek",
    "plc",
    "automation",
    "hmi",
    "lars"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build && npm run docs:actions:check",
    "start": "node dist/server.js",
    "start:catalog": "node dist/serverCatalog.js",
    "start:class2": "node dist/servers/class2.js",
    "start:visu": "node dist/servers/visu.js",
    "start:screen": "node dist/servers/screen.js",
    "start:lars": "node dist/servers/lars.js",
    "start:solution": "node dist/servers/solution.js",
    "init": "node dist/cli/init.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server.js",
    "test": "vitest run",
    "test:actions": "vitest run test/actionRegistry.test.ts test/actionExecutor.test.ts test/actionTools.test.ts test/projectOverride.test.ts test/projectLock.test.ts test/projectCapabilities.test.ts test/catalogCoverage.test.ts test/larsConfigParity.test.ts test/larsScenario.test.ts test/larsDoctor.test.ts test/hmiRuntimeGuard.test.ts test/actionsDoc.test.ts test/init.test.ts test/actionEval.test.ts",
    "test:eval": "vitest run test/actionEval.test.ts",
    "test:lab": "vitest run --config vitest.lab.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "docs:actions": "node dist/scripts/generateActionsDoc.js",
    "docs:actions:check": "node dist/scripts/generateActionsDoc.js --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
