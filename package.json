{
  "name": "lasal-mcp",
  "version": "0.2.0",
  "description": "MCP server for LASAL IDE automation",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "lasal-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Svel26 <sjjansen06@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Svel26/Lasal-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Svel26/Lasal-MCP/issues"
  },
  "homepage": "https://github.com/Svel26/Lasal-MCP#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lasal",
    "sigmatek",
    "plc",
    "automation",
    "hmi",
    "lars"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build",
    "start": "node dist/server.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.9.3",
    "playwright-core": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
